# Copier ce fichier en .env et adapter les valeurs. Ne jamais commiter le .env.
DATABASE_URL="postgresql://aster:aster@localhost:5432/aster?schema=public"

# Secret de signature des jetons JWT : 32 caractères minimum, aléatoire.
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="remplacer-par-une-valeur-aleatoire-de-48-octets-minimum"
JWT_EXPIRES_IN="8h"

PORT=3000
# Origines autorisées pour le CORS (séparées par des virgules). Inutile derrière Nginx.
CORS_ORIGINS="http://localhost:5173"

# Seuils de supervision
POSTE_HORS_LIGNE_SECONDES=120
CPU_ALERTE_POURCENT=90
