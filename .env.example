# Facultatif : sans ce fichier, docker compose utilise des valeurs de démonstration.
# Pour un vrai déploiement, copier en .env et remplacer les valeurs. Le fichier .env ne doit jamais être commité.

# Mot de passe de la base PostgreSQL (défaut de démonstration : parcform)
POSTGRES_PASSWORD=changer-ce-mot-de-passe

# Secret de signature des jetons JWT. Laisser vide : un secret aléatoire est généré au premier démarrage.
JWT_SECRET=

# false en production : pas de données ni de comptes de démonstration
SEED_DEMO=false
SEED_MOT_DE_PASSE=ParcForm#2026

# Port HTTP publié sur la machine hôte
PORT_HTTP=8080
