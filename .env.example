# Copier en .env puis remplacer les valeurs. Le fichier .env ne doit jamais être commité.

# Mot de passe de la base PostgreSQL
POSTGRES_PASSWORD=changer-ce-mot-de-passe

# Secret de signature des jetons JWT (48 octets aléatoires) :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# true = charge les données de démonstration au premier démarrage et affiche les comptes de démo
SEED_DEMO=true
SEED_MOT_DE_PASSE=ParcForm#2026

# Port HTTP publié sur la machine hôte
PORT_HTTP=8080
